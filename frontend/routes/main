from flask import Flask, jsonify, request
import sys
import os
from db.database import get_db_connection
import traceback
import json
from datetime import datetime

app = Flask(__name__)

BASE_DIR = os.path.abspath(os.path.join(os.path.dirname(__file__), ".."))
sys.path.insert(0, BASE_DIR)

@app.route("/employees")
def employees():
    conn = None
    try:
        conn = get_db_connection()
        cur = conn.cursor()
        cur.execute("""
            SELECT
                emp_no,
                emp,
                emp_id,
                last_name,
                first_name,
                shift_name,
                position,
                department
            FROM employees
            ORDER BY emp_id
        """)
        rows = cur.fetchall()
        return jsonify([
            {
                "emp_no": r[0], "emp":   r[1],
                "emp_id": r[2], "last_name":   r[3],
                "first_name":  r[4], "shift_name": r[5], "position": r[6],
                "department":  r[7],
            }
            for r in rows
        ])
    finally:
        if conn:
            conn.close()


@app.route("/agencies")
def agencies():
    conn = None
    try:
        conn = get_db_connection()
        cur = conn.cursor()
        cur.execute("SELECT emp, agency_code FROM agencies")
        rows = cur.fetchall()
        return jsonify([{"agency_id": r[0], "agency_code": r[1]} for r in rows])
    finally:
        if conn:
            conn.close()

